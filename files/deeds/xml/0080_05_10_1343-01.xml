   <text>
      <body><div><pb facs="#facs_0080_05_10_1343-01" n="0080_05_10_1343-01" xml:id="img_0080_05_10_1343-01"/>
            <ab>
               <l facs="#facs_0080_05_10_1343-01_tr_1_tl_1">Jan bode scepe</l>
               <l facs="#facs_0080_05_10_1343-01_tr_1_tl_2">En̄ bekende dat hi</l>
               <l facs="#facs_0080_05_10_1343-01_tr_1_tl_3">rsam̄ lieden den caplan-</l>
               <l facs="#facs_0080_05_10_1343-01_tr_1_tl_4">danē behoef die viertien</l>
               <l facs="#facs_0080_05_10_1343-01_tr_1_tl_5">er stad rechte . Die hi vʼcreech en</l>
               <l facs="#facs_0080_05_10_1343-01_tr_1_tl_6">was wilen woutʼs des bocs . desewelken</l>
               <l facs="#facs_0080_05_10_1343-01_tr_1_tl_7">es van huise gronde en̄ houe die eyg</l>
               <l facs="#facs_0080_05_10_1343-01_tr_1_tl_8">es huismans . Jn alle dien manieren en̄ ri</l>
               <l facs="#facs_0080_05_10_1343-01_tr_1_tl_9">cheins hadde en̄ houdende was ter stat re</l>
               <l facs="#facs_0080_05_10_1343-01_tr_1_tl_10">de houe en̄ met al dat daer toe hoert de</l>
               <l facs="#facs_0080_05_10_1343-01_tr_1_tl_11">weleke wijf vʼbonden tepande ouʼ den vorseiden</l>
               <l facs="#facs_0080_05_10_1343-01_tr_1_tl_12">uaene en̄ tegheuene van hen en̄ van horen nacomelinghe</l>
               <l facs="#facs_0080_05_10_1343-01_l_1">die nv sijn en̄ namaels sijn selen euwelec durende alle jare ou</l>
               <l facs="#facs_0080_05_10_1343-01_tr_1_tl_15">naest den kerstdaghe . Voert gheloefde de vorseide jmbrecht dit vorseide</l>
               <l facs="#facs_0080_05_10_1343-01_l">en̄ al dat daer toe hoert . tewaerne den vorseiden caplanen quite en̄ los van</l>
               <l facs="#facs_0080_05_10_1343-01_tr_1_tl_18">en̄ calaengen opden vorseiden cheins . Jn kennessen van desen letteʼn beseghelt</l>
               <l facs="#facs_0080_05_10_1343-01_tr_1_tl_19">zeghelen . Ghegheuē jnt jaer ons heʼn alsm̄ screef . M . CCC . viertech en̄ drie des s</l>
               <l facs="#facs_0080_05_10_1343-01_tr_1_tl_20">sente Remijs en̄ sente bauen dach</l>
            </ab>
      </div></body>
